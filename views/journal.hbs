 <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MindHaven Journal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/journal.css">
  <link rel="stylesheet" href="/css/darkstyles.css" id="darkThemeStylesheet" disabled>
</head>
<body>
  <!-- Include Header -->
  {{> header user=user landing=false}}
  
  <div class="journal-container">
    <!-- Sidebar -->
    <aside class="journal-sidebar">
      <h3>📓 MindHaven</h3>
      
      <nav class="sidebar-nav" role="tablist">
        <a href="#write" class="nav-link active" data-bs-toggle="tab" role="tab" aria-controls="write" aria-selected="true">
          <i class="bi bi-pencil"></i> Write
        </a>
        <a href="#entries" class="nav-link" data-bs-toggle="tab" role="tab" aria-controls="entries" aria-selected="false">
          <i class="bi bi-journal-text"></i> Entries
        </a>
        <a href="#timeline" class="nav-link" data-bs-toggle="tab" role="tab" aria-controls="timeline" aria-selected="false">
          <i class="bi bi-calendar-heart"></i> Mood Timeline
        </a>
        <a href="#moodboard" class="nav-link" data-bs-toggle="tab" role="tab" aria-controls="moodboard" aria-selected="false">
          <i class="bi bi-palette"></i> Mood Board
        </a>
        <a href="#stats" class="nav-link" data-bs-toggle="tab" role="tab" aria-controls="stats" aria-selected="false">
          <i class="bi bi-bar-chart"></i> Insights
        </a>
      </nav>
      
      <div class="mt-4 pt-3 border-top">
        <h6 class="mb-2">Quick Mood</h6>
        <div class="quick-mood-buttons" id="quickMoodButtons">
          <button class="mood-btn" data-emotion="joy">
            <i class="bi bi-emoji-smile"></i> Joy
          </button>
          <button class="mood-btn" data-emotion="gratitude">
            <i class="bi bi-emoji-heart-eyes"></i> Grateful
          </button>
          <button class="mood-btn" data-emotion="neutral">
            <i class="bi bi-emoji-neutral"></i> Neutral
          </button>
          <button class="mood-btn" data-emotion="stress">
            <i class="bi bi-emoji-dizzy"></i> Stress
          </button>
        </div>
      </div>
      
      <div class="mt-4 pt-3 border-top">
        <label class="theme-switch mb-3" style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0;">
          <span style="font-size: 0.9rem; color: inherit;">Dark Mode</span>
          <input type="checkbox" id="themeToggle">
          <span class="slider round"></span>
        </label>
        <a href="/chat" class="btn btn-outline-secondary w-100">
          <i class="bi bi-arrow-left"></i> Back to Chat
        </a>
      </div>
    </aside>
    
    <!-- Main Content -->
    <main class="journal-main">
      <div class="tab-content">
        <!-- Write Tab -->
        <div class="tab-pane fade show active" id="write" role="tabpanel">
          <h2 class="mb-4">Write Journal Entry</h2>
          <div class="row">
            <div class="col-lg-8">
              <div class="journal-form">
                <div class="mb-3">
                  <label class="form-label">Title (optional)</label>
                  <input type="text" class="form-control" id="journalTitle" placeholder="How I'm feeling today...">
                </div>
                <div class="mb-3">
                  <label class="form-label">Your Thoughts</label>
                  <textarea class="journal-textarea" id="journalContent" rows="8" 
                            placeholder="Write freely about your day, feelings, thoughts, or anything on your mind..."></textarea>
                </div>
                <div class="mb-3">
                  <label class="form-label">Tags (optional, comma separated)</label>
                  <input type="text" class="form-control" id="journalTags" placeholder="work, family, gratitude, stress">
                </div>
                <div class="d-flex gap-2">
                  <button class="btn btn-primary" id="saveJournal">
                    <i class="bi bi-save"></i> Save & Analyze
                  </button>
                  <button class="btn btn-outline-secondary" id="quickSave">
                    <i class="bi bi-lightning"></i> Quick Save
                  </button>
                </div>
              </div>
            </div>
            
            <div class="col-lg-4">
              <div class="prompts-container">
                <h6 class="mb-3"><i class="bi bi-lightbulb"></i> Journaling Prompts</h6>
                <div id="promptsList">
                  <div class="prompt-item">• What am I grateful for today?</div>
                  <div class="prompt-item">• What challenged me today?</div>
                  <div class="prompt-item">• How am I really feeling right now?</div>
                  <div class="prompt-item">• What would make tomorrow better?</div>
                  <div class="prompt-item">• What did I learn about myself today?</div>
                </div>
                <button class="btn btn-sm btn-outline-primary mt-3 w-100" id="newPrompt">
                  <i class="bi bi-shuffle"></i> New Prompt
                </button>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Entries Tab -->
        <div class="tab-pane fade" id="entries" role="tabpanel">
          <h2 class="mb-4">Your Journal Entries</h2>
          <div class="mb-3">
            <input type="text" class="form-control" id="searchEntries" placeholder="Search entries...">
          </div>
          <div id="entriesList">
            <!-- Entries will be loaded here -->
          </div>
          <div class="text-center mt-4">
            <button class="btn btn-outline-primary" id="loadMoreEntries">
              <i class="bi bi-arrow-clockwise"></i> Load More
            </button>
          </div>
        </div>
        
        <!-- Timeline Tab -->
        <div class="tab-pane fade" id="timeline" role="tabpanel">
          <h2 class="mb-4">Mood Timeline</h2>
          <div class="btn-group mb-4">
            <button class="btn btn-outline-primary period-btn active" data-period="week">Week</button>
            <button class="btn btn-outline-primary period-btn" data-period="month">Month</button>
            <button class="btn btn-outline-primary period-btn" data-period="3months">3 Months</button>
            <button class="btn btn-outline-primary period-btn" data-period="year">Year</button>
          </div>
          
          <div class="timeline-container">
            <h6 class="mb-3">Mood Intensity Over Time</h6>
            <canvas id="moodChart"></canvas>
          </div>
          
          <div class="row mt-4">
            <div class="col-md-6">
              <div class="timeline-container">
                <h6 class="mb-3">Emotion Distribution</h6>
                <canvas id="emotionChart"></canvas>
              </div>
            </div>
            <div class="col-md-6">
              <div class="timeline-container">
                <h6 class="mb-3">Weekly Patterns</h6>
                <canvas id="weeklyChart"></canvas>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Mood Board Tab -->
        <div class="tab-pane fade" id="moodboard" role="tabpanel">
          <h2 class="mb-4">Mood Board</h2>
          <div class="btn-group mb-4">
            <button class="btn btn-outline-primary period-btn active" data-period="week">Week</button>
            <button class="btn btn-outline-primary period-btn" data-period="month">Month</button>
            <button class="btn btn-outline-primary period-btn" data-period="3months">3 Months</button>
          </div>
          <div class="mood-board" id="moodBoard">
            <!-- Mood board will be loaded here -->
          </div>
        </div>
        
        <!-- Insights Tab -->
        <div class="tab-pane fade" id="stats" role="tabpanel">
          <h2 class="mb-4">Journal Insights</h2>
          
          <div class="row mb-4">
            <div class="col-md-4">
              <div class="stats-card">
                <div class="stats-number" id="totalEntries">0</div>
                <div class="stats-label">Total Entries</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="stats-card">
                <div class="stats-number" id="streakCount">0</div>
                <div class="stats-label">Day Streak</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="stats-card">
                <div class="stats-number" id="avgWords">0</div>
                <div class="stats-label">Avg Words</div>
              </div>
            </div>
          </div>
          
          <div class="row">
            <div class="col-md-6">
              <div class="timeline-container">
                <h6 class="mb-3">Top Emotions</h6>
                <ul class="list-group" id="topEmotions">
                  <!-- Top emotions will be listed here -->
                </ul>
              </div>
            </div>
            <div class="col-md-6">
              <div class="timeline-container">
                <h6 class="mb-3">Top Topics</h6>
                <ul class="list-group" id="topTopics">
                  <!-- Top topics will be listed here -->
                </ul>
              </div>
            </div>
          </div>
          
          <div class="timeline-container mt-4">
            <h6 class="mb-3">Personal Patterns</h6>
            <div class="row" id="personalPatterns">
              <div class="col-12">
                <p class="text-muted">Loading patterns...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Entry Detail Modal -->
  <div class="modal fade" id="entryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="entryModalTitle"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <small class="text-muted" id="entryModalDate"></small>
            <div class="badge bg-secondary ms-2" id="entryModalMood"></div>
          </div>
          <div class="mb-3" id="entryModalTags"></div>
          <div class="entry-content" id="entryModalContent"></div>
          
          <div class="mt-4 border-top pt-3">
            <h6><i class="bi bi-robot"></i> AI Analysis</h6>
            <div class="ai-analysis" id="entryModalAnalysis"></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-outline-primary" id="editEntryBtn">
            <i class="bi bi-pencil"></i> Edit
          </button>
          <button type="button" class="btn btn-danger" id="deleteEntryBtn">
            <i class="bi bi-trash"></i> Delete
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mood Detail Modal -->
  <div class="modal fade" id="moodDetailModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Mood Details</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="text-center mb-3">
            <div class="mood-icon-large" id="moodDetailIcon"></div>
            <h4 id="moodDetailEmotion"></h4>
          </div>
          <div class="mb-3">
            <strong>Date:</strong> <span id="moodDetailDate"></span>
          </div>
          <div class="mb-3">
            <strong>Related Entries:</strong>
            <div id="moodDetailEntries"></div>
          </div>
          <div class="mb-3">
            <strong>Common Triggers:</strong>
            <div id="moodDetailTriggers"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Loading Spinner -->
  <div class="loading-spinner" id="loadingSpinner" style="display: none;">
    <div class="spinner-border text-primary"></div>
    <p>Processing...</p>
  </div>

  <!-- Bootstrap JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- Journal JavaScript -->
  <script src="/js/journal.js"></script>
  <script src="/js/charts.js"></script>
  
  <script>
    // Stubs to bridge inline handlers to journal.js app
    function quickSaveEntry() {
      if (window.journalApp) { window.journalApp.saveJournalEntry(true); }
    }
    function loadEntries() {
      if (window.journalApp) { window.journalApp.currentPage = 1; window.journalApp.loadJournalEntries(); }
    }
    function updateCharts(period) {
      if (window.journalApp) {
        window.journalApp.currentPeriod = period || window.journalApp.currentPeriod;
        window.journalApp.loadMoodTimeline();
        window.journalApp.loadMoodBoard();
        window.journalApp.loadStats();
      }
    }
    function searchEntries(query) {
      if (window.journalApp && window.journalApp.searchEntries) { window.journalApp.searchEntries(query); }
    }
    function loadMoreEntries() {
      if (window.journalApp && window.journalApp.loadMoreEntries) { window.journalApp.loadMoreEntries(); }
    }
    function generateNewPrompt() {
      if (window.journalApp && window.journalApp.generateNewPrompt) { window.journalApp.generateNewPrompt(); }
    }
    function saveQuickMood(emotion) {
      if (window.journalApp && window.journalApp.logQuickMood) { window.journalApp.logQuickMood(emotion); }
    }
    // Initialize when document is ready
    document.addEventListener('DOMContentLoaded', function() {
      // Wait for Bootstrap and journal.js to be fully loaded
      // Tab navigation is handled by journal.js, so we just need to initialize from URL hash
      const urlHash = window.location.hash;
      if (urlHash) {
        // Wait for journal.js to initialize, then activate the tab
        const checkJournalApp = setInterval(() => {
          if (window.journalApp && typeof bootstrap !== 'undefined') {
            clearInterval(checkJournalApp);
            const targetTab = document.querySelector(`a[href="${urlHash}"]`);
            if (targetTab) {
              // Use Bootstrap's natural tab switching
              targetTab.click();
            }
          }
        }, 50);
        
        // Timeout after 2 seconds if journal.js doesn't load
        setTimeout(() => clearInterval(checkJournalApp), 2000);
      }

      // Quick mood buttons
      document.querySelectorAll('.mood-btn').forEach(button => {
        button.addEventListener('click', function() {
          const emotion = this.getAttribute('data-emotion');
          saveQuickMood(emotion);
        });
      });

      // Period buttons for charts
      document.querySelectorAll('.period-btn').forEach(button => {
        button.addEventListener('click', function() {
          document.querySelectorAll('.period-btn').forEach(btn => btn.classList.remove('active'));
          this.classList.add('active');
          const period = this.getAttribute('data-period');
          updateCharts(period);
        });
      });

      // Save journal button
      document.getElementById('saveJournal').addEventListener('click', saveJournalEntry);

      // Quick save button
      document.getElementById('quickSave').addEventListener('click', quickSaveEntry);

      // Search entries
      document.getElementById('searchEntries').addEventListener('input', searchEntries);

      // Load more entries
      document.getElementById('loadMoreEntries').addEventListener('click', loadMoreEntries);

      // Generate new prompt
      document.getElementById('newPrompt').addEventListener('click', generateNewPrompt);
    });

    // Global functions (to be implemented in journal.js)
    async function saveJournalEntry() {
      const title = document.getElementById('journalTitle').value;
      const content = document.getElementById('journalContent').value;
      const tags = document.getElementById('journalTags').value;

      if (!content.trim()) {
        alert('Please write something before saving.');
        return;
      }

      showLoading();
      
      try {
        const response = await fetch('/api/journal/entries', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            title: title || undefined,
            content: content,
            tags: tags.split(',').map(tag => tag.trim()).filter(tag => tag),
            timestamp: new Date().toISOString()
          })
        });

        const result = await response.json();

        if (result.success) {
          // Clear form
          document.getElementById('journalTitle').value = '';
          document.getElementById('journalContent').value = '';
          document.getElementById('journalTags').value = '';
          
          // Show success message
          alert('Entry saved successfully!');
          
          // Reload entries if on entries tab
          if (document.querySelector('#entries').classList.contains('active')) {
            loadEntries();
          }
          
          // Update stats via journal app if available
          if (window.journalApp && window.journalApp.loadStats) {
            window.journalApp.loadStats();
          }
        } else {
          alert('Error saving entry: ' + result.message);
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Failed to save entry. Please try again.');
      } finally {
        hideLoading();
      }
    }

    function saveQuickMood(emotion) {
      // Implementation for quick mood saving
      console.log('Saving quick mood:', emotion);
      // AJAX call to save mood
    }

    function updateCharts(period) {
      // Implementation for updating charts based on period
      console.log('Updating charts for period:', period);
    }

    function showLoading() {
      document.getElementById('loadingSpinner').style.display = 'flex';
    }

    function hideLoading() {
      document.getElementById('loadingSpinner').style.display = 'none';
    }

    // Other functions would be in separate JS files

    /* ------------------------------
        THEME TOGGLE
    ------------------------------ */
    (function initTheme() {
      const toggle = document.getElementById("themeToggle");
      if (!toggle) return;

      const saved = localStorage.getItem("theme");
      const isDark = saved === "dark";
      const darkStylesheet = document.getElementById("darkThemeStylesheet");

      document.body.classList.toggle("dark-theme", isDark);
      if (darkStylesheet) darkStylesheet.disabled = !isDark;
      toggle.checked = isDark;

      toggle.addEventListener("change", () => {
        const nowDark = toggle.checked;
        document.body.classList.toggle("dark-theme", nowDark);
        if (darkStylesheet) darkStylesheet.disabled = !nowDark;
        localStorage.setItem("theme", nowDark ? "dark" : "light");
      });
    })();
  </script>
</body>
</html>